# Variáveis usadas pelo docker-compose.yml (na VPS, copie para .env e preencha)
# Em produção, use segredos com pelo menos 32 caracteres.
JWT_SECRET=
JWT_REFRESH_SECRET=

# Web Push (VAPID) — gere com: npx web-push generate-vapid-keys
# Os mesmos valores que estão em mensagens-backend/.env
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:admin@oo.infinityforge.com.br

# Seed (opcional) — credenciais para `docker compose exec backend node src/scripts/createAdmin.js`.
# Sem senha definida, a criação do respectivo usuário é pulada.
SEED_ADMIN_NAME=Administrador
SEED_ADMIN_EMAIL=
SEED_ADMIN_PASSWORD=
SEED_TEST_NAME=Usuário Teste
SEED_TEST_EMAIL=
SEED_TEST_PASSWORD=
