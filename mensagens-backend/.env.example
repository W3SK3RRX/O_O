# Backend Environment Variables
PORT=3000
MONGO_URI=mongodb://localhost:27017/mensagens
# Em produção, use segredos com pelo menos 32 caracteres
JWT_SECRET=sua_jwt_secret_aqui
JWT_REFRESH_SECRET=sua_refresh_secret_aqui
JWT_EXPIRES_IN=1h
JWT_REFRESH_EXPIRES_IN=7d
CORS_ORIGIN=http://localhost:5173
LOG_LEVEL=info
# Gere o par com: npx web-push generate-vapid-keys
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:admin@example.com
